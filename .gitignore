.venv/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
# Node and Rust build trees
node_modules/
target/
dist/
out/
release/
# Solver output: light fields and phase maps run to gigabytes
*.npz
*.npy
# Light-field screen scenes are ~100 MB each; build_viz_scene.py rebuilds them.
tier1_lightfield/foveated_optics_study/blender/*.blend
*.blend1
# Literature. PDFs of published papers are not ours to redistribute, so none
# are tracked: not the agents' downloads under docs/papers, and not one left
# in the root either. Findings go in docs/notes_*.md with a citation instead.
docs/papers/
*.pdf

# Lean build tree. .lake holds the Mathlib cache and runs to about 7 GB;
# `lake build` refetches it from the toolchain pinned in lean-toolchain.
lean/**/.lake/

# Long runs and results that must survive a reboot (not tracked)
scratchpad/
